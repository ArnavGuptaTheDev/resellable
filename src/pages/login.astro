---
import Shell from '../layouts/Shell.astro';
---
<Shell title="Sign in" public>
  <section class="gate">
    <div class="panel">
      <p class="eyebrow">// access terminal</p>
      <h1 class="glow-text">Sign in</h1>
      <p class="muted">Resellable is invite-only. Sign in with the Google account your invite was sent to.</p>
      <p class="notice tag tag-danger" role="alert" hidden></p>
      <a class="btn google" href="/auth/login">
        <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
          <path fill="currentColor" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.3Z" />
          <path fill="currentColor" d="M12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22Z" opacity=".8" />
          <path fill="currentColor" d="M6.4 14c-.2-.6-.3-1.3-.3-2s.1-1.4.3-2V7.4H3.1a10 10 0 0 0 0 9.2L6.4 14Z" opacity=".6" />
          <path fill="currentColor" d="M12 6c1.5 0 2.8.5 3.8 1.5l2.9-2.9A10 10 0 0 0 3.1 7.4L6.4 10C7.2 7.8 9.4 6 12 6Z" opacity=".9" />
        </svg>
        Continue with Google
      </a>
    </div>
  </section>
</Shell>

<script>
  import { getSession } from '../lib/session';

  const params = new URLSearchParams(location.search);
  const raw = params.get('next') ?? '/';
  const next = raw.startsWith('/') && !raw.startsWith('//') && !raw.startsWith('/\\') ? raw : '/';

  const btn = document.querySelector<HTMLAnchorElement>('.google');
  if (btn) btn.href = `/auth/login?next=${encodeURIComponent(next)}`;

  const messages: Record<string, string> = {
    cancelled: 'Sign-in was cancelled.',
    expired: 'That sign-in attempt expired. Please try again.',
  };
  const error = params.get('error');
  const notice = document.querySelector<HTMLElement>('.notice');
  if (error && notice) {
    notice.textContent = messages[error] ?? 'Sign-in failed. Please try again.';
    notice.hidden = false;
  }

  // Already signed in? Skip the gate.
  getSession()
    .then((s) => {
      if (s) location.replace(next);
    })
    .catch(() => {});
</script>

<style>
  .gate {
    display: grid;
    place-items: center;
    min-height: calc(100dvh - var(--header-height) - 120px);
  }

  .gate .panel {
    width: 100%;
    max-width: 420px;
    padding: 28px var(--gutter);
  }

  .notice {
    display: block;
    margin-bottom: 16px;
    padding: 8px 10px;
    text-transform: none;
    letter-spacing: 0;
    font-family: var(--font-text);
    font-size: 0.9rem;
  }

  .notice[hidden] {
    display: none;
  }

  .google {
    width: 100%;
  }
</style>
