---
import '@fontsource/chakra-petch/latin-500.css';
import '@fontsource/chakra-petch/latin-700.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  /** Which nav entry to highlight. */
  nav?: 'browse' | 'sell' | 'deals' | 'admin';
  /** Signed-in pages (the default) redirect to /login when there is no session. */
  public?: boolean;
}

const { title, nav, public: isPublic = false } = Astro.props;

// `needs` only hides links the role can't use; the API enforces roles.
const links = [
  { id: 'browse', href: '/', label: 'Browse', needs: undefined, icon: 'M4 6h16M4 12h16M4 18h10' },
  { id: 'sell', href: '/sell', label: 'Sell', needs: 'seller', icon: 'M12 5v14M5 12h14' },
  { id: 'deals', href: '/deals', label: 'Deals', needs: undefined, icon: 'M4 5h16v11H8l-4 4V5Z' },
  { id: 'admin', href: '/admin', label: 'Admin', needs: 'superuser', icon: 'M12 3l8 4v5c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V7l8-4Z' },
] as const;
---
<!doctype html>
<html lang="en" class={isPublic ? undefined : 'auth-pending'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f3f0e6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#07080d" media="(prefers-color-scheme: dark)" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Resellable</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Resellable" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
      // Keep the install prompt for our own "Install" button (fires once, maybe before modules load).
      window.__bip = null;
      addEventListener('beforeinstallprompt', function (e) {
        e.preventDefault();
        window.__bip = e;
        dispatchEvent(new Event('bip-ready'));
      });
    </script>
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Resellable home">
          <span class="brand-mark" aria-hidden="true">R/</span>
          <span class="brand-name">Resellable</span>
        </a>
        {!isPublic && (
          <nav class="top-nav" aria-label="Primary">
            {links.map((l) => (
              <a href={l.href} data-needs={l.needs} aria-current={nav === l.id ? 'page' : undefined}>
                {l.label}
                {l.id === 'deals' && <span class="badge" data-badge="deals" hidden></span>}
              </a>
            ))}
          </nav>
        )}
        <div class="header-actions">
          {!isPublic && (
            <a class="icon-btn cart-link" href="/cart" aria-label="Cart" title="Cart">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 4h2l2.4 11h10.2L20 8H7" />
                <circle cx="9.5" cy="19" r="1.4" />
                <circle cx="17" cy="19" r="1.4" />
              </svg>
              <span class="badge" data-badge="cart" hidden></span>
            </a>
          )}
          <ThemeToggle />
          {!isPublic && (
            <div class="user-chip" hidden>
              <a class="avatar" href="/settings" aria-label="Settings" title="Settings"></a>
              <button type="button" class="icon-btn sign-out" aria-label="Sign out" title="Sign out">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M15 4h4v16h-4M10 8l-4 4 4 4M6 12h10" />
                </svg>
              </button>
            </div>
          )}
        </div>
      </div>
    </header>

    <main id="main" class="container">
      {!isPublic && (
        <noscript><p class="panel">Resellable needs JavaScript to load your data.</p></noscript>
      )}
      <slot />
    </main>

    {!isPublic && (
      <div class="pwa-banner" role="region" aria-label="App" hidden>
        <img src="/icons/icon-192.png" alt="" width="40" height="40" />
        <p class="pb-text"></p>
        <div class="pb-actions">
          <button type="button" class="btn pb-yes"></button>
          <button type="button" class="btn btn-ghost pb-no">Not now</button>
        </div>
      </div>
    )}

    {!isPublic && (
      <nav class="tabbar" aria-label="Primary">
        {links.map((l) => (
          <a href={l.href} data-needs={l.needs} aria-current={nav === l.id ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={l.icon} />
            </svg>
            <span>{l.label}</span>
            {l.id === 'deals' && <span class="badge" data-badge="deals" hidden></span>}
          </a>
        ))}
      </nav>
    )}

    <script>
      import { getSession, loginUrl } from '../lib/session';
      import { api } from '../lib/api';
      import { renderBadges, type Attention } from '../lib/badges';
      import { dismiss, dismissedRecently, disablePush, enablePush, installState, pushState, promptInstall, syncPush } from '../lib/pwa';

      /** One banner at a time: install first (iOS needs it for notifications), then notifications. */
      async function pickBanner() {
        const el = document.querySelector<HTMLElement>('.pwa-banner');
        if (!el) return;
        const text = el.querySelector('.pb-text')!;
        const yes = el.querySelector<HTMLButtonElement>('.pb-yes')!;
        const no = el.querySelector<HTMLButtonElement>('.pb-no')!;
        const show = (msg: string, label: string, onYes: () => Promise<void> | void, what: 'install' | 'push') => {
          text.textContent = msg;
          yes.textContent = label;
          yes.onclick = async () => {
            yes.disabled = true;
            try {
              await onYes();
            } finally {
              yes.disabled = false;
              el.hidden = true;
              void pickBanner();
            }
          };
          no.onclick = () => {
            dismiss(what);
            el.hidden = true;
            void pickBanner();
          };
          el.hidden = false;
        };

        const install = installState();
        if (install === 'prompt' && !dismissedRecently('install')) {
          return show('Install Resellable: opens like an app, works offline, and can notify you about offers.', 'Install', async () => {
            if (!(await promptInstall())) dismiss('install');
          }, 'install');
        }
        if (install === 'ios' && !dismissedRecently('install')) {
          return show('Install on iPhone: tap Share, then “Add to Home Screen”. Needed for notifications on iOS.', 'Got it', () => dismiss('install'), 'install');
        }
        if ((await pushState()) === 'off' && !dismissedRecently('push')) {
          return show('Get a notification when someone makes an offer, accepts, or messages you.', 'Turn on', async () => {
            const state = await enablePush();
            if (state !== 'on') dismiss('push');
          }, 'push');
        }
        el.hidden = true;
      }

      /** Cart units + deals needing the user. Refreshed every minute while visible and on demand. */
      async function refreshBadges() {
        try {
          renderBadges(await api<Attention>('/api/deals/attention'));
        } catch {
          /* badges are best-effort */
        }
      }

      const root = document.documentElement;
      // Only signed-in pages render with .auth-pending; public pages skip this.
      async function boot() {
        if (!root.classList.contains('auth-pending')) return;
        try {
          const session = await getSession();
          if (!session) {
            location.replace(loginUrl());
            return;
          }
          const { user } = session;
          root.dataset.role = user.role;

          const chip = document.querySelector<HTMLElement>('.user-chip');
          const avatar = chip?.querySelector<HTMLElement>('.avatar');
          if (chip && avatar) {
            const label = user.name || user.email;
            avatar.title = `${label} · ${user.role}`;
            if (user.avatarUrl) {
              const img = document.createElement('img');
              img.src = user.avatarUrl;
              img.alt = '';
              img.referrerPolicy = 'no-referrer';
              avatar.append(img);
            } else {
              avatar.textContent = label.slice(0, 1).toUpperCase();
            }
            chip.hidden = false;
          }

          document.querySelector('.sign-out')?.addEventListener('click', async () => {
            try {
              // Stop this device receiving the signed-out user's notifications.
              await disablePush().catch(() => {});
              await api('/auth/logout', { method: 'POST' });
            } finally {
              location.replace('/login');
            }
          });

          root.classList.remove('auth-pending');
          void refreshBadges();
          setInterval(() => document.visibilityState === 'visible' && void refreshBadges(), 60_000);
          document.addEventListener('visibilitychange', () => document.visibilityState === 'visible' && void refreshBadges());
          document.addEventListener('attention:refresh', () => void refreshBadges());

          void syncPush();
          void pickBanner();
          addEventListener('bip-ready', () => void pickBanner());
          addEventListener('appinstalled', () => void pickBanner());
          // A push arrived while the app is open: refresh badges and the open deal.
          navigator.serviceWorker?.addEventListener('message', (e) => {
            if ((e.data as { type?: string })?.type === 'push') {
              void refreshBadges();
              document.dispatchEvent(new CustomEvent('deal:refresh'));
            }
          });
        } catch (err) {
          console.error(err);
          root.classList.remove('auth-pending');
          root.classList.add('auth-error');
        }
      }
      void boot();

      // App shell + static assets only; /api, /auth and /img are never cached (see scripts/sw.template.js).
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((err) => console.warn('service worker', err));
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* Hide signed-in content until /api/me confirms the session. */
  html.auth-pending main {
    visibility: hidden;
  }

  /* Role-gated nav (cosmetic; the API enforces roles). */
  html:not([data-role='seller']):not([data-role='superuser']) [data-needs='seller'],
  html:not([data-role='superuser']) [data-needs='superuser'] {
    display: none !important;
  }
</style>

<style>
  .user-chip {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .user-chip[hidden] {
    display: none;
  }

  .cart-link {
    position: relative;
  }

  .badge {
    display: inline-grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    margin-left: 4px;
    border-radius: 9px;
    background: var(--accent);
    color: var(--text-on-accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
    box-shadow: var(--glow-strong);
  }

  .badge[hidden] {
    display: none;
  }

  .cart-link .badge {
    position: absolute;
    top: -6px;
    right: -6px;
    margin: 0;
  }

  .tabbar a {
    position: relative;
  }

  .tabbar .badge {
    position: absolute;
    top: 6px;
    left: calc(50% + 8px);
    margin: 0;
  }

  .pwa-banner {
    position: fixed;
    left: var(--gutter);
    right: var(--gutter);
    bottom: calc(var(--tabbar-height) + env(safe-area-inset-bottom) + 10px);
    z-index: 70;
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 10px 12px;
    align-items: center;
    max-width: 560px;
    margin: 0 auto;
    padding: 12px;
    background: var(--surface);
    border: 1px solid var(--accent);
    box-shadow: var(--card-shadow), var(--glow-strong);
  }

  .pwa-banner[hidden] {
    display: none;
  }

  .pwa-banner img {
    border-radius: 8px;
  }

  .pb-text {
    margin: 0;
    font-size: 0.9rem;
  }

  .pb-actions {
    grid-column: 1 / -1;
    display: flex;
    gap: 8px;
    justify-content: flex-end;
  }

  .pb-actions .btn {
    min-height: 40px;
    font-size: 0.85rem;
  }

  @media (min-width: 768px) {
    .pwa-banner {
      bottom: 16px;
      grid-template-columns: 40px 1fr auto;
    }
    .pb-actions {
      grid-column: auto;
    }
  }

  .avatar {
    text-decoration: none;
  }

  .avatar {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    overflow: hidden;
    border: 1px solid var(--accent-2);
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--accent-2);
    font-family: var(--font-display);
    font-weight: 700;
  }

  .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .skip:focus {
    position: fixed !important;
    top: 8px;
    left: 8px;
    width: auto;
    height: auto;
    clip: auto;
    z-index: 200;
    padding: 8px 12px;
    background: var(--surface);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 16px;
    height: var(--header-height);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .brand:hover {
    color: var(--text);
  }

  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    background: var(--accent);
    color: var(--text-on-accent);
    font-size: 0.85rem;
    clip-path: polygon(0 0, 100% 0, 100% 70%, 70% 100%, 0 100%);
    box-shadow: var(--glow-strong);
  }

  .brand-name {
    text-shadow: var(--text-glow);
  }

  /* Small phones: the mark alone, so the header actions fit. */
  @media (max-width: 400px) {
    .brand-name {
      display: none;
    }
    .header-actions {
      gap: 6px;
    }
  }

  .top-nav {
    display: none;
    gap: 4px;
    margin-left: 16px;
  }

  .top-nav a {
    padding: 8px 12px;
    color: var(--text-muted);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.9rem;
    border-bottom: 2px solid transparent;
  }

  .top-nav a:hover {
    color: var(--text);
  }

  .top-nav a[aria-current='page'] {
    color: var(--text);
    border-bottom-color: var(--accent);
  }

  .header-actions {
    margin-left: auto;
    display: flex;
    gap: 8px;
  }

  /* Bottom tab bar on phones */
  .tabbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    height: calc(var(--tabbar-height) + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--surface);
    border-top: 1px solid var(--border);
  }

  .tabbar a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    color: var(--text-muted);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tabbar svg {
    width: 22px;
    height: 22px;
  }

  .tabbar a[aria-current='page'] {
    color: var(--accent);
    box-shadow: inset 0 2px 0 var(--accent);
  }

  @media (min-width: 768px) {
    .top-nav {
      display: flex;
    }
    .tabbar {
      display: none;
    }
  }
</style>
