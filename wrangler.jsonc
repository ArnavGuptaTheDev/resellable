{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resellable",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Astro's static build output.
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only these paths hit the Worker; everything else is served straight from assets.
    "run_worker_first": ["/api/*", "/auth/*", "/img/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "resellable",
      // Create once with `npx wrangler d1 create resellable` and paste the id here.
      // Not a secret: it is useless without an API token for your account.
      "database_id": "022545d6-9c96-4bde-a064-2d0c8e91fc39",
      "migrations_dir": "migrations"
    }
  ],
  // Plain, non-secret config. Secrets (GOOGLE_CLIENT_SECRET, SESSION_SECRET,
  // SUPERUSER_EMAILS) are set with `wrangler secret put` and never live here.
  "vars": {
    // Public OAuth client id (it appears in the Google sign-in URL anyway).
    "GOOGLE_CLIENT_ID": "831131607860-ikbvd4egjuads07lkd5jp2obual99v4e.apps.googleusercontent.com",
    "CURRENCY": "INR"
  },
  "observability": { "enabled": true }
}
