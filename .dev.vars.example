# Copy to .dev.vars for local dev (git-ignored). Placeholders only — never put real values in this file.
# In production, set secrets with `npx wrangler secret put NAME` (see README → Secrets).

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Locally this overrides the GOOGLE_CLIENT_ID var in wrangler.jsonc.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.example
GOOGLE_CLIENT_SECRET=your-client-secret

# Comma-separated emails that always have access and the superuser role
SUPERUSER_EMAILS=you@example.com

# Random string, at least 32 chars. Signs the short-lived OAuth state cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Local only. `npm run dev` serves the UI on :4321 and proxies to the Worker,
# so OAuth redirects and the CSRF origin check must use the proxy's origin.
APP_ORIGIN=http://localhost:4321

# Local only. Enables /auth/dev-login?email=... on localhost so you can sign in
# as any invited email without Google. Never set this in production.
DEV_LOGIN=true

# Web Push (optional locally). Generate a local pair: node scripts/vapid.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
